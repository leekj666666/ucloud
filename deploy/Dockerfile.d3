FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
WORKDIR /app
RUN pip install --no-cache-dir uv==0.13.5
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY backend ./backend
COPY diagnosis/runner_v3.py ./diagnosis/runner_v3.py
COPY deploy/d3-build-manifest.json ./build-manifest.json
ENV PYTHONPATH=/app/backend PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1 CLOUDSRE_VERSION_MANIFEST=/app/build-manifest.json
USER 1000
CMD ["python","-m","cloudsre.worker_v3"]
